# The resident Nostr relay worker, one instance per installation.
#
#   %i is the site directory under /home/users/satoshiskleinazeigen/www,
#   without the domain suffix: "staging" or "new".
#
# Install (as root):
#   cp tools/systemd/sk-nostr-worker@.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now sk-nostr-worker@staging
#   journalctl -u sk-nostr-worker@staging -f
#
# The worker ends itself every few minutes and is started again here.
# More than ten starts in five minutes means it is crashing, and the unit
# stops instead of looping; the cron poll keeps the mailboxes served.

[Unit]
Description=SK-Core Nostr relay worker (%i)
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=satoshiskleinazeigen
Group=satoshiskleinazeigen
WorkingDirectory=/home/users/satoshiskleinazeigen/www/%i.satoshiskleinanzeigen.space
ExecStart=/opt/keyhelp/php/8.3/bin/php /home/users/satoshiskleinazeigen/www/%i.satoshiskleinanzeigen.space/wp-content/plugins/sk-core/tools/nostr-worker.php
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15
MemoryMax=512M
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sk-nostr-worker-%i

[Install]
WantedBy=multi-user.target
