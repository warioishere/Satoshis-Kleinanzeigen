{
  "name": "sk-nostr-verify-build",
  "private": true,
  "description": "Builds assets/js/sk-nostr-verify.js from entry.js. Run: npm install && npm run build",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2017 --legal-comments=inline --outfile=../../assets/js/sk-nostr-verify.js"
  },
  "devDependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "esbuild": "0.25.9"
  }
}
